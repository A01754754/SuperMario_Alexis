            <ui:Label text="Tarea Unity" class="header" style="font-size: 100px; background-color: rgba(0, 0, 0, 0.39); width: 1200px; align-self: center; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; -unity-text-align: upper-center; color: rgb(255, 250, 250); -unity-background-image-tint-color: rgba(0, 0, 0, 0.39);"/>
        </ui:VisualElement>
