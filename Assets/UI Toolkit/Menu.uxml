            <ui:Button text="" name="cerrarVentana" style="background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Saurabh_Studio/UI%20button%20and%20hallowing%20element%20pack%205/gold/CLOSE-1.png?fileID=2800000&amp;guid=c0b6c38e965c69c4baaec76c33e68cf3&amp;type=3#CLOSE-1&quot;); width: 120px; height: 120px; align-self: flex-end; align-content: stretch; align-items: center; left: auto; right: auto; bottom: auto; top: 1px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
